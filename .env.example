# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"            # production: a Postgres URL (see README)
SITE_URL="https://www.example.tn"        # public site URL, no trailing slash
ADMIN_PASSWORD=""                        # long random password for /admin
ADMIN_SESSION_SECRET=""                  # 64 random hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_DIR="./storage"                  # uploaded photos + quote attachments (must persist)
RESEND_API_KEY=""                        # optional: https://resend.com API key for e-mail notifications
MAIL_FROM=""                             # optional: e.g. "AmenPlus <devis@domaine-valide.tn>"
QUOTE_NOTIFY_TO=""                       # optional: comma-separated recipients (overrides admin setting)
